# Database
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=spovie_db
DB_USERNAME=spovie_user
DB_PASSWORD=spovie_pass

# React (Vite)
VITE_API_BASE_URL=http://localhost/api

# Upload limit shown in the UI (keep equal to backend UPLOAD_MAX_MB)
VITE_MAX_UPLOAD_MB=200

# Realtime（Pusher Channels）。未設定ならリアルタイム機能は無効。backend/.env の PUSHER_APP_KEY と同じ値
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap4
