APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap4

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Media (WP2) ---
# 本番: FILESYSTEM_DISK=s3 + AWS_* (AWS S3 / Cloudflare R2)。ローカル開発は public
# R2 の場合: AWS_DEFAULT_REGION=auto, AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com, AWS_USE_PATH_STYLE_ENDPOINT=true
UPLOAD_MAX_MB=200
# 空欄なら s3 ドライバのとき一時署名URLを使う。公開バケット(AWS_URL)で配信するなら false
MEDIA_TEMPORARY_URLS=
MEDIA_URL_TTL_MINUTES=60

# --- Production only (Railway). 詳細は docs/deployment.md ---
# CORS_ALLOWED_ORIGINS=https://<vercel-domain>
# CORS_ALLOWED_ORIGINS_PATTERNS=
# SANCTUM_STATEFUL_DOMAINS=<vercel-domain>

# --- Realtime (WP5, Pusher Channels) ---
# ローカル開発は BROADCAST_DRIVER=log のままでキー不要（イベントはログに出力される）。
# 本番は BROADCAST_DRIVER=pusher にして、上の PUSHER_APP_ID / PUSHER_APP_KEY / PUSHER_APP_SECRET /
# PUSHER_APP_CLUSTER（Pusher ダッシュボードの App Keys の値）を設定する。詳細は docs/deployment.md
